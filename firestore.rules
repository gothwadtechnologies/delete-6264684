rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == "pawangothwad@gmail.com"); // Master Admin Email
    }

    // Global configuration
    match /config/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      // Allow reading own profile, or any profile if admin
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow creating own profile, but force role to 'student'
      allow create: if isOwner(userId) && 
                      request.resource.data.role == 'student';
      
      // Allow updating own profile, but prevent changing role
      allow update: if isOwner(userId) && 
                      request.resource.data.role == resource.data.role;
      
      // Admins can do anything
      allow write: if isAdmin();
    }

    // Batches, Classes, etc.
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
